{
  "name": "runlytics",
  "version": "1.0.0",
  "private": true,
  "description": "Runlytics — Personal Fitness Analytics Platform",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,magenta -k \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "build": "npm run build --workspace=frontend",
    "start": "npm run start --workspace=backend",
    "lint": "npm run lint --workspace=frontend",
    "test": "concurrently -n backend,frontend -c blue,magenta \"npm test --workspace=backend\" \"npm test --workspace=frontend\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
