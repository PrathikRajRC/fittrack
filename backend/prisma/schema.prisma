// Runlytics — Prisma schema
//
// Default: SQLite (zero-setup, works immediately)
// Switch to PostgreSQL: change provider to "postgresql" and update DATABASE_URL
// to: postgresql://user:password@localhost:5432/fittrack

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── User (app account) ────────────────────────────────────────────────────────
// Email/password account. Owns at most one linked Strava athlete.
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String?  // null for accounts created via Google (no password)
  googleId     String?  @unique // Google "sub" — set for Google-linked accounts
  name         String?
  avatar       String?  // profile picture URL (from Google)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  athlete      Athlete?
  importData   ImportData?
}

// ── Imported Strava-export data (per account) ─────────────────────────────────
// Stores a user's locally-parsed Strava archive so it persists across logins
// and devices. Kept as JSON blobs (matches the browser import-mode shape).
model ImportData {
  userId     Int      @id
  athlete    String   // JSON of the synthetic import athlete
  activities String   // JSON array of parsed activities
  count      Int
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ── Athlete ───────────────────────────────────────────────────────────────────
model Athlete {
  id        Int      @id   // Strava athlete ID
  userId    Int?     @unique // linked app account (null until Strava is linked)
  data      String         // Full Strava athlete JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      AthleteToken?
  activities Activity[]
  goals      Goal[]
  syncStatus SyncStatus?
}

// ── OAuth tokens (kept separate for security) ─────────────────────────────────
model AthleteToken {
  athleteId    Int      @id
  accessToken  String
  refreshToken String
  expiresAt    Int      // Unix timestamp (seconds)
  updatedAt    DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

// ── Activity cache ────────────────────────────────────────────────────────────
// Stores full Strava activity JSON so the app doesn't re-fetch on every page load.
model Activity {
  id        String   @id   // Strava activity ID (stored as string to avoid BigInt issues)
  athleteId Int
  startDate DateTime
  type      String
  data      String         // Full Strava activity JSON (stringified)
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId, startDate(sort: Desc)])
}

// ── Sync bookkeeping ──────────────────────────────────────────────────────────
model SyncStatus {
  athleteId   Int      @id
  lastSyncAt  DateTime @default(now())
  totalSynced Int      @default(0)

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)
}

// ── Goals ─────────────────────────────────────────────────────────────────────
model Goal {
  id        Int      @id @default(autoincrement())
  athleteId Int
  type      String
  label     String
  target    Float
  unit      String
  createdAt DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: Cascade)

  @@index([athleteId])
}

// ── Webhook subscription cache ────────────────────────────────────────────────
model WebhookSubscription {
  id          Int      @id   // Strava subscription ID
  callbackUrl String
  verifyToken String
  createdAt   DateTime @default(now())
}

// ── Activity stream cache ─────────────────────────────────────────────────────
// Caches Strava's stream data (heartrate, altitude, latlng, etc.) so we don't
// re-fetch them every time a user opens a workout detail page.
model ActivityStream {
  activityId String   @id
  keys       String   // CSV of stream keys cached in this row
  data       String   // JSON-stringified streams object
  updatedAt  DateTime @updatedAt
}
